{
  "name": "md-editor-plus-lifeos",
  "displayName": "MD Editor Plus — Life OS",
  "description": "Editor Markdown visual por blocos com cores herdadas do VS Code. Fork pessoal do MD Editor Plus.",
  "version": "0.9.4",
  "publisher": "guilherme8682",
  "license": "MIT",
  "author": {
    "name": "Aviran Revach",
    "email": "aviran@atera.com"
  },
  "homepage": "https://github.com/guilherme8682/md-editor-plus#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/guilherme8682/md-editor-plus.git"
  },
  "bugs": {
    "url": "https://github.com/guilherme8682/md-editor-plus/issues"
  },
  "engines": {
    "vscode": "^1.74.0"
  },
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#0F0F0F",
    "theme": "dark"
  },
  "categories": [
    "Notebooks",
    "Visualization",
    "Other"
  ],
  "keywords": [
    "markdown",
    "md",
    "editor",
    "viewer",
    "wysiwyg",
    "block editor",
    "notion",
    "notion-style",
    "preview",
    "notes",
    "latex",
    "math",
    "katex",
    "mdx"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "customEditors": [
      {
        "viewType": "md-editor-plus-lifeos.editor",
        "displayName": "MD Editor Plus — Life OS",
        "selector": [
          {
            "filenamePattern": "*.md"
          },
          {
            "filenamePattern": "*.markdown"
          },
          {
            "filenamePattern": "*.mdown"
          },
          {
            "filenamePattern": "*.mkd"
          },
          {
            "filenamePattern": "*.mdx"
          }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "mdEditorPlusLifeos.openSourceView",
        "title": "MD Editor Plus — Life OS: Open Source View"
      },
      {
        "command": "mdEditorPlusLifeos.openBlockView",
        "title": "MD Editor Plus — Life OS: Open Block View"
      }
    ],
    "configuration": {
      "title": "MD Editor Plus — Life OS",
      "properties": {
        "mdEditorPlusLifeos.font": {
          "type": "string",
          "enum": [
            "sans",
            "serif",
            "mono"
          ],
          "default": "sans",
          "description": "Default font family"
        },
        "mdEditorPlusLifeos.textSize": {
          "type": "string",
          "enum": [
            "s",
            "m",
            "l",
            "xl"
          ],
          "default": "m",
          "description": "Default text size"
        },
        "mdEditorPlusLifeos.pageWidth": {
          "type": "number",
          "default": 800,
          "minimum": 400,
          "maximum": 2400,
          "description": "Default page width in pixels"
        },
        "mdEditorPlusLifeos.fullWidth": {
          "type": "boolean",
          "default": false,
          "description": "Default to full window width"
        },
        "mdEditorPlusLifeos.sourceFullWidth": {
          "type": "boolean",
          "default": false,
          "description": "Always render the source (Code) view at full window width"
        },
        "mdEditorPlusLifeos.shortenCodeSnippets": {
          "type": "boolean",
          "default": false,
          "description": "Collapse long code snippets to a preview with a Show more button"
        },
        "mdEditorPlusLifeos.outlineVisible": {
          "type": "boolean",
          "default": false,
          "description": "Show the outline panel (left gutter) by default"
        },
        "mdEditorPlusLifeos.structureMapVisible": {
          "type": "boolean",
          "default": false,
          "description": "Show the structure map (right-edge navigation rail) by default"
        },
        "mdEditorPlusLifeos.frontmatterVisible": {
          "type": "boolean",
          "default": true,
          "description": "Show the frontmatter fields row above the document by default"
        },
        "mdEditorPlusLifeos.sourceWordWrap": {
          "type": "boolean",
          "default": false,
          "description": "Wrap long lines in the Code (source) view instead of horizontal scrolling"
        },
        "mdEditorPlusLifeos.smartTypography": {
          "type": "boolean",
          "default": true,
          "description": "Smart typography: replace typed sequences like -> with arrows (→), -- with em dash (—), ... with ellipsis (…) as you type. Suppressed inside code."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p tsconfig.json && node esbuild.config.js",
    "watch": "concurrently \"tsc -p tsconfig.json -w\" \"node esbuild.config.js --watch\"",
    "test": "jest",
    "package": "vsce package",
    "publish:vscode": "vsce publish",
    "publish:openvsx": "ovsx publish"
  },
  "devDependencies": {
    "@phosphor-icons/core": "^2.1.1",
    "@tiptap/core": "^2.7.0",
    "@tiptap/extension-bubble-menu": "^2.27.2",
    "@tiptap/extension-code-block-lowlight": "^2.7.0",
    "@tiptap/extension-color": "^2.27.2",
    "@tiptap/extension-highlight": "^2.27.2",
    "@tiptap/extension-image": "^2.7.0",
    "@tiptap/extension-link": "^2.7.0",
    "@tiptap/extension-table": "^2.7.0",
    "@tiptap/extension-table-cell": "^2.7.0",
    "@tiptap/extension-table-header": "^2.7.0",
    "@tiptap/extension-table-row": "^2.7.0",
    "@tiptap/extension-task-item": "^2.7.0",
    "@tiptap/extension-task-list": "^2.7.0",
    "@tiptap/extension-text-style": "^2.27.2",
    "@tiptap/extension-underline": "^2.27.2",
    "@tiptap/starter-kit": "^2.7.0",
    "@types/jest": "^29.0.0",
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.74.0",
    "@vscode/vsce": "^2.0.0",
    "concurrently": "^8.0.0",
    "esbuild": "^0.21.0",
    "jest": "^29.0.0",
    "jest-environment-jsdom": "^30.4.1",
    "katex": "^0.16.47",
    "lowlight": "^3.1.0",
    "markdown-it-texmath": "^1.0.0",
    "mermaid": "^11.4.0",
    "ovsx": "^0.9.0",
    "tiptap-extension-global-drag-handle": "^0.1.18",
    "tiptap-markdown": "^0.8.10",
    "ts-jest": "^29.0.0",
    "typescript": "^5.4.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.ts"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/.worktrees/"
    ],
    "moduleNameMapper": {
      "\\.css$": "<rootDir>/tests/__mocks__/fileMock.js",
      "^(\\.{1,2}/)*editor$": "<rootDir>/tests/__mocks__/editorMock.js",
      "^mermaid$": "<rootDir>/tests/__mocks__/mermaidMock.js"
    },
    "transform": {
      "^.+\\.tsx?$": [
        "ts-jest",
        {
          "tsconfig": "tsconfig.webview.json"
        }
      ]
    }
  }
}
